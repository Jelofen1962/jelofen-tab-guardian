{
  "manifest_version": 3,
  "name": "JTG - Jelofen's Tab Guardian",
  "short_name": "JTG",
  "version": "1.4.0",
  "description": "Dynamic tab locking, per-site rules, close confirmation, and GitHub release update notifications for Chrome and Edge.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "sessions",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.github.com/*",
    "https://img.icons8.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JTG - Jelofen's Tab Guardian",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
